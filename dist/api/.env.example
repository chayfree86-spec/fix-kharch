# ------------------------------------------------------------------
# fix-kharch backend configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ------------------------------------------------------------------

# --- fix-kharch's own MySQL database (created automatically if missing) ---
DB_HOST=127.0.0.1
DB_NAME=fix_spend
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Staff-app integration (staff data is fetched over HTTP) ---
# Base URL of the Staff-app PHP API (no trailing slash).
STAFF_APP_API_URL=http://localhost/Staff-app/api
# Shared secret. MUST match EXTERNAL_STAFF_API_KEY in Staff-app's api/.env
STAFF_APP_API_KEY=change-me

# --- Frontend origins allowed to call this API (comma-separated) ---
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
